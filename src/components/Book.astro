---
import ReceptionistPanel from "./ReceptionistPanel.astro";
---

<section 
  id="book" 
  class="section section--tight wrap book-section" 
  aria-labelledby="book-title"
>
  <header class="section-head">
    <img src="/logo.webp" alt="" class="section-logo" loading="lazy" />
    <h2 id="book-title" class="section-title">Let’s brew something calm</h2>
    <p class="section-subtle">
      Tell our receptionist what you need. We’ll reply within a day — usually faster.
    </p>
  </header>

  <ReceptionistPanel actionUrl="/api/chat" />
</section>